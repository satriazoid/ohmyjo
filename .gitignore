# Build output. rsrc.syso is generated from assets/ohmyjo.ico but is committed,
# so an ordinary build does not depend on the rsrc tool being installed; only
# the executable itself stays out of the repository.
/ohmyjo.exe
/ohmyjo
*.exe

# Go's linker writes this next to `-o ohmyjo.exe` when the target is locked by
# a running instance, which is the normal case while developing the app.
*.exe~

# Local scratch. Live probes drive the real window through real input events and
# write screen captures; none of it belongs in a commit.
/win.ps1
/win.js
/win/
/.assistant-text.txt
/.probe*/
/.p??.txt
